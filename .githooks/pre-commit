#!/usr/bin/env bash
#
# .githooks/pre-commit - fast lint checks on staged files.
# Kept deliberately quick (no build, no insmod) so it doesn't discourage
# committing. The full test suite runs at push time instead - see
# .githooks/pre-push.
#
# Enable with: scripts/setup-hooks.sh   (or: git config core.hooksPath .githooks)
# Bypass once with: git commit --no-verify (not recommended)

set -uo pipefail

FAIL=0
# -z + mapfile -d '' (not plain $(...) word-splitting) so a staged
# filename containing a space or newline still becomes exactly one
# array element instead of being split into several bogus paths.
mapfile -d '' -t STAGED < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED[@]}" -eq 0 ]; then
    exit 0
fi

echo "==> pre-commit: linting staged files"

for f in "${STAGED[@]}"; do
    [ -f "$f" ] || continue

    case "$f" in
        av/*.c|av/*.h)
            if command -v cppcheck >/dev/null 2>&1; then
                echo "  - cppcheck: $f"
                cppcheck --quiet --enable=warning,style,performance \
                    --suppress=missingIncludeSystem --inline-suppr \
                    --error-exitcode=1 "$f" || FAIL=1
            else
                echo "  ! cppcheck not installed - skipping static analysis for $f"
                echo "    (sudo pacman -S cppcheck  /  apt install cppcheck)"
            fi
            # Optional stricter kernel style check, only if you point
            # CHECKPATCH at a full kernel source tree's scripts/checkpatch.pl
            # (not included in headers-only packages, so this is opt-in).
            if [ -n "${CHECKPATCH:-}" ] && [ -x "${CHECKPATCH:-}" ]; then
                echo "  - checkpatch.pl: $f"
                "$CHECKPATCH" --no-tree --terse -f "$f" || FAIL=1
            fi
            ;;
        userspace/avctl/*.c)
            echo "  - gcc -fsyntax-only: $f"
            gcc -fsyntax-only -Wall -Wextra "$f" || FAIL=1
            if command -v cppcheck >/dev/null 2>&1; then
                echo "  - cppcheck: $f"
                cppcheck --quiet --enable=warning,style --inline-suppr \
                    --error-exitcode=1 "$f" || FAIL=1
            fi
            ;;
        userspace/avd/*.c)
            NL_LIBS="$(pkg-config --libs libnl-genl-3.0 2>/dev/null)"
            YARA_LIBS="$(pkg-config --libs yara 2>/dev/null)"
            if [ -z "$NL_LIBS" ] || [ -z "$YARA_LIBS" ]; then
                echo "  ! libnl-genl-3.0 and/or yara not found via pkg-config - skipping syntax check for $f"
                echo "    (sudo pacman -S libnl yara ssdeep  /  apt install libnl-genl-3-dev libyara-dev libfuzzy-dev)"
            else
                echo "  - gcc -fsyntax-only: $f"
                # Arrays, not a plain word-split string - avoids any risk
                # of an empty CFLAGS token reaching gcc as a bogus
                # positional argument (which is what "linker input file
                # not found: No such file or directory" with an empty
                # filename means).
                read -r -a NL_CFLAGS_ARR <<< "$(pkg-config --cflags libnl-genl-3.0 2>/dev/null)"
                read -r -a YARA_CFLAGS_ARR <<< "$(pkg-config --cflags yara 2>/dev/null)"
                if ! gcc -fsyntax-only -Wall -Wextra \
                        "${NL_CFLAGS_ARR[@]}" "${YARA_CFLAGS_ARR[@]}" "$f"; then
                    echo "  ! gcc invocation was:"
                    echo "    gcc -fsyntax-only -Wall -Wextra ${NL_CFLAGS_ARR[*]} ${YARA_CFLAGS_ARR[*]} $f"
                    FAIL=1
                fi
            fi
            ;;
        corpus/*.txt)
            echo "  - corpus format check: $f (non-comment, non-blank lines must contain a comma)"
            # ^[[:space:]]*(#.*)?$ - not ^(#.*)?$: the old pattern missed
            # whitespace-only lines and indented comments ("   # ..."),
            # misclassifying them as data lines.
            if grep -vE '^[[:space:]]*(#.*)?$' "$f" | grep -v ',' | grep -q .; then
                echo "  ! malformed line(s) in $f (missing comma separator)"
                FAIL=1
            fi
            ;;
        rules/*.yar|rules/*.yara|tests/fixtures/*.yar|tests/fixtures/*.yara)
            if command -v yara >/dev/null 2>&1; then
                echo "  - yara --compiled-rules check: $f"
                # `yara <rules> <target>` requires a scan target even to
                # just validate compilation - /bin/true is a harmless
                # always-present stand-in file.
                yara "$f" /bin/true >/dev/null || FAIL=1
            else
                echo "  ! yara CLI not installed - skipping rule syntax check for $f"
                echo "    (sudo pacman -S yara  /  apt install yara)"
            fi
            # Weight lint, production rules only: avd.c sums every matched
            # rule's `weight` meta and convicts at >= 100
            # (MALICIOUS_SCORE_THRESHOLD), so a production rule without a
            # weight scores a silent 0 (dead on arrival) while weight >= 100
            # lets a single rule convict alone, bypassing the combination
            # model - exactly how test.yar's weight=100 override=true went
            # unnoticed before it was quarantined to tests/ (upstream #99).
            # Private building blocks never reach avd's scorer (skipped in
            # yara_callback); `global` rules do score, so they are linted
            # like normal rules. Fixtures under tests/ deliberately use
            # weight=100 + override - both are exempt.
            case "$f" in
                rules/*)
                    echo "  - yara weight lint: $f"
                    awk '
                        function fail(msg) { print FILENAME": "msg > "/dev/stderr"; bad = 1 }
                        function close_rule() {
                            if (!is_private && !has_weight)
                                fail("rule " rule_name ": missing `weight` meta (avd.c scores it a silent 0)")
                            in_rule = 0; in_meta = 0
                        }
                        {
                            line = $0
                            # Stateful /* ... */ tracking: a `weight = ...`
                            # line inside a multiline comment must not count.
                            # A `//` opening before any `/*` is a line comment
                            # (so `// /*` never opens a block); `//` inside an
                            # already-open block is just comment text.
                            if (in_block) {
                                if (index(line, "*/") == 0)
                                    next
                                line = substr(line, index(line, "*/") + 2)
                                in_block = 0
                            }
                            p_line = index(line, "//")
                            p_blk = index(line, "/*")
                            if (p_line > 0 && (p_blk == 0 || p_line < p_blk))
                                line = substr(line, 1, p_line - 1)
                            while ((p_open = index(line, "/*")) > 0) {
                                p_end = index(substr(line, p_open + 2), "*/")
                                if (p_end > 0)
                                    line = substr(line, 1, p_open - 1) substr(line, p_open + p_end + 3)
                                else {
                                    line = substr(line, 1, p_open - 1)
                                    in_block = 1
                                    break
                                }
                            }
                            if (line ~ /^[ \t]*((private|global)[ \t]+)*rule[ \t]+[A-Za-z_]/) {
                                rest = line
                                sub(/^[ \t]*/, "", rest)
                                # `global` rules score like normal rules - only
                                # `private` building blocks are exempt.
                                is_private = 0
                                while (rest ~ /^(private|global)[ \t]+/) {
                                    if (rest ~ /^private[ \t]+/)
                                        is_private = 1
                                    sub(/^(private|global)[ \t]+/, "", rest)
                                }
                                sub(/^rule[ \t]+/, "", rest)
                                if (match(rest, /[^A-Za-z0-9_]/))
                                    rule_name = substr(rest, 1, RSTART - 1)
                                else
                                    rule_name = rest
                                in_rule = 1; in_meta = 0; has_weight = 0
                                header_line = NR
                                # A single-line rule carries everything after
                                # the `{` on this same line - reprocess the
                                # remainder below instead of skipping it.
                                if (line ~ /{/)
                                    sub(/^[^{]*{/, "", line)
                                else
                                    next
                            } else if (!in_rule) {
                                next
                            }
                            if (in_rule && line ~ /^[ \t]*meta[ \t]*:/) {
                                in_meta = 1
                                # Keep anything after `meta:` on the same line -
                                # single-line rules put entries there.
                                sub(/^[^:]*:/, "", line)
                            }
                            if (in_rule && line ~ /^[ \t]*(strings|condition)[ \t]*:/)
                                in_meta = 0
                            if (in_rule && in_meta && !is_private && line ~ /^[ \t]*weight[ \t]*=/) {
                                rest = line
                                sub(/^.*weight[ \t]*=[ \t]*/, "", rest)
                                sub(/[ \t;].*$/, "", rest)
                                # `+ 0` forces a numeric comparison: without it
                                # awk compares numeric-looking strings
                                # lexicographically ("100" <= "99").
                                if (rest ~ /^-?[0-9]+$/ && (rest + 0) >= 1 && (rest + 0) <= 99)
                                    has_weight = 1
                                else {
                                    fail("rule " rule_name ": weight must be an integer 1-99 (got `" rest "`); >= 100 convicts alone at MALICIOUS_SCORE_THRESHOLD")
                                    has_weight = 1
                                }
                            }
                            # Rule end: `}` on its own line (repo style), or
                            # anywhere on a single-line rule.
                            if (in_rule && (line ~ /^[ \t]*}[ \t]*$/ || (NR == header_line && line ~ /}/)))
                                close_rule()
                        }
                        END { exit (bad ? 1 : 0) }
                    ' "$f" || FAIL=1
                    ;;
            esac
            ;;
        tests/*.sh|.githooks/*)
            if command -v shellcheck >/dev/null 2>&1; then
                echo "  - shellcheck: $f"
                shellcheck "$f" || FAIL=1
            else
                echo "  - bash -n (shellcheck not installed): $f"
                bash -n "$f" || FAIL=1
            fi
            ;;
        *.yml|*.yaml)
            if command -v yamllint >/dev/null 2>&1; then
                echo "  - yamllint: $f"
                yamllint "$f" || FAIL=1
            fi
            ;;
    esac
done

if [ "$FAIL" -ne 0 ]; then
    echo
    echo "pre-commit: lint failed - fix the issues above, or bypass with"
    echo "  git commit --no-verify   (not recommended)"
    exit 1
fi

echo "pre-commit: lint passed"
exit 0
